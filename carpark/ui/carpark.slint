import { Button } from "std-widgets.slint";

enum Screen { vacant, occupied, paying, alarm }

export global Format {
    pure function pad2(value: int) -> string {
        return value < 10 ? "0" + value : value;
    }
    public pure function hhmm(seconds: int) -> string {
        return Format.pad2(Math.floor(seconds / 3600)) + ":"
             + Format.pad2(Math.mod(Math.floor(seconds / 60), 60));
    }
}

export global ParkingState {
    in-out property <bool> occupied: false;
    in-out property <int> parked-seconds: 0;
    pure function fee-for(seconds: int) -> int {
        return Math.ceil(seconds / 10) * 10;
    }
    out property <int> fee:
        ParkingState.fee-for(ParkingState.parked-seconds);
}

component Header inherits Rectangle {
    in property text <=> label.text;
    in property size <=> label.font-size;
    label := Text {
        color: white;
        font-size: 40px;
    }
}

component LabeledValue inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> unit;
    in property <brush> text-color: white;
    alignment: center;
    Text {
        text: root.label; font-size: 14px;
        horizontal-alignment: center;
        color: root.text-color;
    }
    HorizontalLayout {
        alignment: center; spacing: 3px;
        Text {
            text: root.value; font-size: 24px;
            horizontal-alignment: root.unit == "" ? center : right;
            width: root.unit == "" ? self.preferred-width : 58px;
            color: root.text-color;
        }
        if root.unit != "": Text {
            text: root.unit; font-size: 24px;
            color: root.text-color;
        }
    }
}

component VacantScreen inherits VerticalLayout {
    callback park();
    // ToF が無いときだけ手動の入庫ボタンを出す. 有れば検知に任せて全面を緑に.
    in property <bool> manual: true;
    Header {
        vertical-stretch: 2; background: #1f8a4c;
        text: "空車"; size: 72px;
    }
    if root.manual: Button {
        vertical-stretch: 1;
        text: "駐車を開始";
        primary: true;
        clicked => { root.park(); }
    }
}

component OccupiedScreen inherits VerticalLayout {
    callback start-pay();
    Header {
        vertical-stretch: 2; background: #a03a2e;
        text: "駐車中"; size: 72px;
    }
    Button {
        vertical-stretch: 1;
        text: "精算へ";
        primary: true;
        clicked => { root.start-pay(); }
    }
}

component PayingScreen inherits VerticalLayout {
    in property <string> parked-time;
    in property <int> due;
    // QR スキャナが無いときだけ手動の精算ボタンを出す.
    in property <bool> manual: true;
    callback paid();
    callback cancel-pay();
    Timer {
        interval: 30s;
        running: true;
        triggered => { root.cancel-pay(); }
    }
    // 精算中の帯. 空車 (緑)・駐車中 (赤) と同じ「色帯 + 白文字」に揃える.
    Rectangle {
        vertical-stretch: 2;
        background: #ae5600;  /* 精算中の帯. 白文字が読める暗さのオレンジ */
        HorizontalLayout {
            alignment: center; spacing: 28px;
            LabeledValue { label: "駐車時間"; value: root.parked-time; }
            LabeledValue { label: "料金"; value: root.due; unit: "円"; }
        }
    }
    HorizontalLayout {
        vertical-stretch: 1;
        Button {
            text: "取り消す";
            clicked => { root.cancel-pay(); }
        }
        if root.manual: Button {
            text: "支払い完了"; primary: true;
            clicked => { root.paid(); }
        }
    }
}

// 精算前に車が居なくなったときの画面. 赤い帯を点滅させる.
component AlarmScreen inherits VerticalLayout {
    in property <bool> blink;
    callback dismiss();
    Rectangle {
        vertical-stretch: 2;
        background: root.blink ? #c00000 : #400000;
        VerticalLayout {
            alignment: center;
            Text {
                text: "警報"; font-size: 72px; color: white;
                horizontal-alignment: center;
            }
            Text {
                text: "精算前に車が出ました"; font-size: 18px; color: white;
                horizontal-alignment: center;
            }
        }
    }
    Button {
        vertical-stretch: 1;
        text: "警報を止める";
        clicked => { root.dismiss(); }
    }
}

export component AppWindow inherits Window {
    preferred-width: 320px;
    preferred-height: 240px;
    default-font-size: root.height / 10;
    out property <Screen> screen: Screen.vacant;

    // 入口は 2 つ (画面のボタンと, センサ). その先の処理はここに 1 つだけ.
    // C++ からは invoke_arrive / invoke_paid で, ボタンからは下の各画面から呼ぶ.
    // C++ が起動時に device_is_ready() の結果を入れる. UI はこれで
    // 手動ボタンを出すか決める. 既定は false で, ユニットが無ければ
    // ボタンで操作できる.
    in property <bool> has-tof: false;
    in property <bool> has-scanner: false;
    callback arrive();
    callback paid();
    arrive => {
        ParkingState.occupied = true;
        ParkingState.parked-seconds = 0;
        root.screen = Screen.occupied;
    }
    paid => {
        ParkingState.occupied = false;
        root.screen = Screen.vacant;
    }

    // 警報. 精算前に車が居なくなったら C++ が alarm を呼ぶ.
    // 車が戻れば (C++ が car-returned を呼ぶ) 駐車の続きとして駐車中に戻る.
    // 係の人が画面のボタンで止めれば, 車は出ていったものとして空車に戻す.
    // 駐車時間は警報のあいだも数え続ける.
    callback alarm();
    callback car-returned();
    callback dismiss-alarm();
    alarm => { root.screen = Screen.alarm; }
    dismiss-alarm => {
        ParkingState.occupied = false;
        root.screen = Screen.vacant;
    }
    car-returned => {
        if root.screen == Screen.alarm { root.screen = Screen.occupied; }
    }

    // 警報中だけ 0.5 秒ごとに反転する. 画面, LED, 振動モータがこれに合わせる.
    out property <bool> blink: false;
    Timer {
        interval: 500ms;
        running: root.screen == Screen.alarm;
        triggered => { root.blink = !root.blink; }
    }
    callback blink-changed();
    changed blink => { root.blink-changed(); }

    // 警報を抜けたら点滅を消灯の側で止める.
    changed screen => {
        if root.screen != Screen.alarm { root.blink = false; }
    }

    // LED 用.
    // LED は画面用の色をそのまま使うと白っぽく光る (3 チャンネルとも値を持つ
    // 淡い色は, 暗くしても彩度が上がらないため). LED 専用に彩度を上げた色にする.
    // 警報中は blink に合わせて赤を点滅させる.
    out property <color> led-color:
        root.screen == Screen.alarm ? (root.blink ? #ff0000 : #000000)
        : ParkingState.occupied ? #ff0000 : #00ff00;
    // 色が変わるたびに C++ へ知らせる (状態が切り替わる瞬間だけ).
    callback led-color-changed();
    changed led-color => { root.led-color-changed(); }

    // フラップ板. 角度ではなくサーボのパルス幅 (us) で持つ. 中央 1500, ±150 = ±15 度.
    // 車が居るあいだは立てて (1350) ロックし, 空車では伏せて (1650) 出られるようにする.
    out property <int> flap-goal: root.screen == Screen.vacant ? 1650 : 1350;
    out property <int> flap-angle: root.flap-goal;
    animate flap-angle { duration: 2s; easing: ease-in-out-sine; }
    callback flap-angle-changed();
    changed flap-angle => { root.flap-angle-changed(); }

    Timer {
        interval: 1s;
        running: ParkingState.occupied;
        triggered => { ParkingState.parked-seconds += 1; }
    }

    if root.screen == Screen.vacant: VacantScreen {
        manual: !root.has-tof;
        park => { root.arrive(); }
    }
    if root.screen == Screen.occupied: OccupiedScreen {
        start-pay => { root.screen = Screen.paying; }
    }
    if root.screen == Screen.paying: PayingScreen {
        parked-time: Format.hhmm(ParkingState.parked-seconds);
        due: ParkingState.fee;
        manual: !root.has-scanner;
        paid => { root.paid(); }
        cancel-pay => { root.screen = Screen.occupied; }
    }
    if root.screen == Screen.alarm: AlarmScreen {
        blink: root.blink;
        dismiss => { root.dismiss-alarm(); }
    }
}
