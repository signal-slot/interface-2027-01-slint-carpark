 * SPDX-License-Identifier: MIT OR Apache-2.0
 *
 * Core2 本体の Port A と, 背面に積んだ Module ExtPort For Core2 の各ポート.
 *
 *   Port A (G32)     : RGB LED (SK6812). SPI の MOSI で波形を作る.
 *                      Zephyr の WS2812 ビットバン・ドライバは nRF 専用で,
 *                      ESP32 には RMT ドライバも無いため.
 *   Port B (G26/G36) : フラップ板のサーボ. PWM は G26. G36 は入力専用で未使用.
 *   Port C (G13/G14) : ToF 測距センサ (VL53L0X). I2C.
 *   Port D (G34/G35) : 空けてある. 下記参照.
 *   Port E (G27/G19) : QR コードスキャナ. UART.
 *                      Grove の黄線が G19, 白線が G27 (ExtPort の pin map).
 *                      スキャナは黄で受けて白で送るので, TX=G19, RX=G27.
 *                      ExtPort の DIP は Port E の「19」と「27」を ON にする.
 *                      片方だけだと, 送れるのに返事が来ない中途半端な壊れ方を
 *                      する (サーボは 1 線しか使わないので気付けない).
 *
 * ToF とサーボは板の近くに置くので, 隣り合う B と C に寄せてある.
 * サーボが B なのは G36 が入力専用で, D (G34/G35 とも入力専用) には
 * PWM も I2C も置けないため. この 2 つは物理的にここしか選べない.
 *
 * 周辺機器はどれも必須ではない.
 *
 *   Core2 単体         画面とタッチだけで一通り動く. 入庫と出庫はボタンになる.
 *   Core2 + どれか 1 つ 本体の Port A にはどれか 1 つを挿せる.
 *   Core2 + ExtPort    4 つを同時に挿して全部組み合わせられる.
 *
 * どれが繋がっているかは, この overlay の aliases が決める. アプリは alias が
 * あるかどうかをコンパイル時に, device_is_ready() を実行時に見て, 無いものは
 * 画面のボタンで代わりを出す. この overlay の無いボードやパソコン上でも,
 * 画面だけのアプリとしてそのまま動く.
 *
 * Port D は読者のために空けてある. 照度センサを挿してナイトモードにしても,
 * 人感センサを挿して人が近づいたときだけ画面を点けてもよい. G34/G35 はどちらも
 * 入力専用ピンなので, デジタル入力かアナログ入力か UART の受信に向く.
 * I2C のユニットなら, Port C と同じバスに Bottom2 の PORT.C からぶら下げる
 * こともできる (アドレスが被らないこと).
 */

#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	flap: flap {
		compatible = "pwm-servo";
		pwms = <&ledc0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		/* FeeTech FS0403. 900〜2100 us で約 120 度.
		 * 9 g 級のサーボは動き出しにほぼ停動電流を引き, Core2 の Grove 5V
		 * では本体ごと電源が落ちる. FS0403 は動作 70 mA で収まる. */
		min-pulse = <PWM_USEC(900)>;
		max-pulse = <PWM_USEC(2100)>;
	};

	/* アプリは node label ではなく alias で周辺機器を引く.
	 *
	 * node label はボードごとに意味が違う. たとえば uart1 は, このボードでは
	 * Port B に出ている QR スキャナの線だが, 別のボードでは無関係の UART である.
	 * alias なら「この駐車場アプリの何なのか」を宣言することになるので,
	 * 取り違えようがない. アプリ側は alias の有無だけを見て,
	 * 無ければその周辺機器を使わない実装に切り替える. */
	aliases {
		carpark-scanner = &uart1;
		carpark-tof = &tof;
		carpark-indicator = &indicator;
		carpark-flap = &flap;
		carpark-buzzer = &vib_motor;
		carpark-unit-bus = &i2c1;
	};
};

&pinctrl {
	ledc0_flap: ledc0_flap {
		group1 {
			pinmux = <LEDC_CH0_GPIO26>;
			output-enable;
		};
	};

	uart1_qr: uart1_qr {
		group1 {
			pinmux = <UART1_TX_GPIO19>;
			output-enable;
		};
		group2 {
			pinmux = <UART1_RX_GPIO27>;
		};
	};

	uart2_gps: uart2_gps {
		group1 {
			pinmux = <UART2_RX_GPIO34>;
		};
	};

	spim2_ws2812: spim2_ws2812 {
		group1 {
			pinmux = <SPIM2_MOSI_GPIO32>;
			output-enable;
		};
	};
};

/* Port A: RGB LED. 6.4MHz で 1 ビットを 8 シンボルに展開し, WS2812 の波形を作る. */
&spi2 {
	status = "okay";
	pinctrl-0 = <&spim2_ws2812>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;

	/* WS2812 を SPI で駆動するための回避策. これが無いと待機レベルが合わない. */
	line-idle-low;

	indicator: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";
		reg = <0>;
		spi-max-frequency = <6400000>;
		/* spi-cpha は外してある. 立てると MOSI がクロックの半周期 (6.4MHz で
		 * 78 ns) ずれる. 転送の途中は前後のビットで辻褄が合うが, 先頭の
		 * シンボルだけは崩れる. それはチェーン先頭の LED の最初のバイト
		 * (color-mapping が GREEN 先頭なので緑) に当たり, 1 個目だけが
		 * 色は合っているのに暗い, という症状になる. */
		chain-length = <3>;
		color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
		spi-one-frame = <0xf0>;  /* 625 ns high, 625 ns low */
		spi-zero-frame = <0xc0>; /* 312.5 ns high, 937.5 ns low */
	};
};

&ledc0 {
	pinctrl-0 = <&ledc0_flap>;
	pinctrl-names = "default";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel0@0 {
		reg = <0x0>;
		timer = <0>;
	};
};

/* Port C: ToF. Core2 の既定は Port A なので, ピンを振り直す. */
&pinctrl {
	i2c1_tof: i2c1_tof {
		group1 {
			/* M5Stack の Grove は pin1 = 白, pin2 = 黄. I2C では pin1 = SCL.
			 * Core2 本体の Port A が sda = G32 (黄), scl = G33 (白) で,
			 * ExtPort の Port C は白 = G13, 黄 = G14 なので
			 * SCL = G13, SDA = G14 になる. */
			pinmux = <I2C1_SDA_GPIO14>,
				 <I2C1_SCL_GPIO13>;
			drive-open-drain;
			output-high;
		};
	};
};

&i2c1 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c1_tof>;
	pinctrl-names = "default";
	sda-gpios = <&gpio0 14 GPIO_OPEN_DRAIN>;
	scl-gpios = <&gpio0 13 GPIO_OPEN_DRAIN>;

	tof: vl53l0x@29 {
		compatible = "st,vl53l0x";
		reg = <0x29>;
	};
};

/* Port E: QR コードスキャナ. 本体のスイッチを UART 側にしておくこと. */
&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart1_qr>;
	pinctrl-names = "default";
};

/* Port D は読者の拡張用に空けてある.
 *
 * ここは何を挿してもよい. 照度センサでナイトモード, 人感センサで人が近づいた
 * ときだけ画面を点ける, GPS で時刻を合わせる, など.
 * 使うときは status を okay にし, ExtPort の Port D の DIP を 34/35 側にする.
 * 例として GPS (NMEA) を繋ぐ形を残してある. */
&uart2 {
	status = "disabled";
	current-speed = <115200>;
	pinctrl-0 = <&uart2_gps>;
	pinctrl-names = "default";

	gps: gnss-nmea-generic {
		compatible = "gnss-nmea-generic";
	};
};
