/* Core2 本体の Port A (G32/G33). i2c1 の既定のピンがそのまま Port A なので,
 * status を okay にして ToF のノードを足すだけ. */
&i2c1 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;

    tof: vl53l0x@29 {
        compatible = "st,vl53l0x";
        reg = <0x29>;
    };
};

/ {
    aliases {
        carpark-tof = &tof;
    };
};
